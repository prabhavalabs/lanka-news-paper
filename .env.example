SNAP_DATABASE_URL=postgres://snap:snap@127.0.0.1:55432/snap?sslmode=disable
SNAP_API_ADDRESS=127.0.0.1:8090
SNAP_ENV=local
SNAP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
SNAP_MIGRATIONS_PATH=migrations
SNAP_SESSION_SECRET=local-dev-session-secret-change
SNAP_BOOTSTRAP_ADMIN_EMAIL=admin@lankanews.com
SNAP_BOOTSTRAP_ADMIN_PASSWORD_HASH=<bcrypt-hash>
SNAP_SESSION_COOKIE_SECURE=false

# OpenRouter key used by the DeepSeek V4 Flash pipeline provider.
OPENROUTER_API_KEY=

# Publisher media uses local disk unless every R2 setting below is provided.
# The project account already has a private `lanka-news-media` bucket.
SNAP_MEDIA_LOCAL_DIR=.data/media
SNAP_R2_ACCOUNT_ID=
SNAP_R2_ACCESS_KEY_ID=
SNAP_R2_SECRET_ACCESS_KEY=
SNAP_R2_BUCKET=
