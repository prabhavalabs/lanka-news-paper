POSTGRES_PASSWORD=<random-url-safe-password>
SNAP_DATABASE_URL=postgres://lanka_news:<same-password>@postgres:5432/lanka_news?sslmode=disable
SNAP_ALLOWED_ORIGINS=https://thulawanews.com,https://admin.thulawanews.com,https://lankanewspaper.prabhavalabs.com,https://admin.lankanewspaper.prabhavalabs.com
SNAP_SESSION_SECRET=<random-session-secret>
SNAP_BOOTSTRAP_ADMIN_EMAIL=admin@lankanews.com
SNAP_BOOTSTRAP_ADMIN_PASSWORD_HASH='<bcrypt-hash>'
RESEND_API_KEY=<resend-api-key>
SNAP_NEWSLETTER_ENABLED=true
SNAP_NEWSLETTER_BASE_URL=https://thulawanews.com
SNAP_NEWSLETTER_FROM="Morning Brief <brief@prabhavalabs.com>"
SNAP_NEWSLETTER_RECIPIENT=<initial-recipient-email-imported-once>
SNAP_NEWSLETTER_TIMEZONE=Asia/Colombo
SNAP_NEWSLETTER_SEND_HOUR=8
SNAP_ADMIN_ANALYSIS_WORKERS=2
SNAP_R2_ACCOUNT_ID=<cloudflare-account-id>
SNAP_R2_ACCESS_KEY_ID=<bucket-scoped-access-key>
SNAP_R2_SECRET_ACCESS_KEY=<bucket-scoped-secret-key>
SNAP_R2_BUCKET=lanka-news-media

# Codex CLI uses ChatGPT login credentials in CODEX_HOME, never an API key.
# Concurrent CLI processes per API/worker process; quota/auth cooldown.
SNAP_CODEX_CONCURRENCY=2
SNAP_CODEX_QUOTA_COOLDOWN=15m
SNAP_CODEX_MODELS=gpt-6-luna,gpt-6.1-sol,gpt-6-sol,gpt-5.6-luna,gpt-5.6-terra

# Optional Facebook Page publishing. Enable selection/review from the admin settings.
# Facebook posts go out through Loomcast. Create an API client in Loomcast (Settings → API
# clients) with publish access to the Thulawa News Facebook channel.
SNAP_LOOMCAST_URL=https://loomcast.prabhavalabs.com
SNAP_LOOMCAST_API_KEY=
# Only needed when the API client is granted more than one Facebook channel.
SNAP_LOOMCAST_CHANNEL_ID=
SNAP_SOCIAL_PUBLIC_BASE_URL=https://thulawanews.com
SNAP_SOCIAL_INCLUDE_LINK=true
SNAP_SOCIAL_CHROME_PATH=/usr/bin/chromium
SNAP_SOCIAL_CHROME_NO_SANDBOX=true
