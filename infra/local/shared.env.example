# Copy these values into the repository-root .env file. Never commit that file.
SNAP_DATABASE_URL=postgres://lanka_news:<production-password>@127.0.0.1:55433/lanka_news?sslmode=disable
SNAP_API_ADDRESS=127.0.0.1:8090
SNAP_ENV=shared-development
SNAP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
SNAP_SESSION_COOKIE_SECURE=false

# Use the same bucket-scoped R2 credentials configured on the VPS.
SNAP_R2_ACCOUNT_ID=<cloudflare-account-id>
SNAP_R2_ACCESS_KEY_ID=<bucket-scoped-access-key>
SNAP_R2_SECRET_ACCESS_KEY=<bucket-scoped-secret-key>
SNAP_R2_BUCKET=lanka-news-media
